# The Express API. Used by Server Components (server-to-server) and by the
# browser (cross-origin fetch with credentials).
NEXT_PUBLIC_API_URL="http://localhost:5002"

# Same value, used for server-side calls. Split out because in a real deployment
# the server often reaches the API over a private hostname while the browser
# uses the public one.
API_INTERNAL_URL="http://localhost:5002"
