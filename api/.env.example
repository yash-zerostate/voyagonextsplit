# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="voyago_demo"

# ── Auth ────────────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="30"

# ── Server ──────────────────────────────────────────────────────────────────
PORT="5002"
NODE_ENV="development"

# The Next.js frontend. CORS allows exactly this origin, with credentials.
WEB_ORIGIN="http://localhost:4002"

# Cookie scope.
#  dev  — leave COOKIE_DOMAIN empty: cookies ignore ports, so a cookie set by
#         localhost:5002 is also sent to localhost:4002.
#  prod — set the shared parent domain (".acme.com") so app.acme.com and
#         api.acme.com both receive it, and set COOKIE_SAMESITE=none with HTTPS.
COOKIE_DOMAIN=""
COOKIE_SAMESITE="lax"
COOKIE_SECURE="false"
